[Unit]
Description=Simulador de parciales (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/parcial2-quiz
ExecStart=%h/parcial2-quiz/.venv/bin/uvicorn server.app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
